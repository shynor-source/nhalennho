# Copy this file to `.env.cloudflare` (git-ignored) and fill in the real values
# before building/deploying the Cloudflare Workers frontend (ADR-0013).
#
# All values here are PUBLIC (NEXT_PUBLIC_* are inlined into the browser
# bundle). Never put secrets in this file — the API holds all secrets in
# its own environment (Render dashboard).
#
# NEXT_PUBLIC_API_URL / INTERNAL_API_URL must point at the Render service
# URL (e.g. https://qg-web-api.onrender.com), NOT localhost, for the
# deployed combo.

NEXT_PUBLIC_SITE_NAME="Nhà Len Nhỏ"
NEXT_PUBLIC_SITE_URL="https://<the-pages-or-worker-domain>"
NEXT_PUBLIC_SITE_TAGLINE="Đồ len xinh xắn — Handmade with love"
NEXT_PUBLIC_SITE_DESCRIPTION="Đồ len handmade và nhận móc theo yêu cầu: móc khóa, thú bông, hoa len và quà tặng ý nghĩa."
NEXT_PUBLIC_SHOPEE_URL="https://shopee.vn/<ten-shop>"
NEXT_PUBLIC_ZALO_URL="https://zalo.me/<so-dien-thoai>"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/<ten-fanpage>"
NEXT_PUBLIC_API_URL="https://<the-render-service-host>"
INTERNAL_API_URL="https://<the-render-service-host>"
