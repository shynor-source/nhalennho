# ============================================================================
# QG_web — environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env.dev` (development) or `.env.production` (VPS) and
# fill in real values. Real env files are git-ignored and must never be
# committed, copied into Docker images, or logged.
#
# Naming rules:
#   - NEXT_PUBLIC_* values are inlined into the build and are PUBLIC. Never put
#     a secret in one. They are read at build time, so changing them requires
#     rebuilding the frontend image.
#   - Server-only secrets (SESSION_SECRET, DB credentials, SMTP, Telegram) are
#     never prefixed with NEXT_PUBLIC_ and never reach the browser.
# ============================================================================

# ---------------------------------------------------------------------------
# Brand / public content — configured per deployment, not hard-coded in source
# ---------------------------------------------------------------------------
# Display name of the shop.
NEXT_PUBLIC_SITE_NAME="Nhà Len Nhỏ"
# Public canonical origin of the website (used for canonical URLs, sitemap).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Short human-readable tagline shown in metadata.
NEXT_PUBLIC_SITE_TAGLINE="Đồ len xinh xắn — Handmade with love"
# Short brand description used for the meta description.
NEXT_PUBLIC_SITE_DESCRIPTION="Đồ len handmade và nhận móc theo yêu cầu: móc khóa, thú bông, hoa len và quà tặng ý nghĩa."

# ---------------------------------------------------------------------------
# External destinations — TODO(owner): fill in the real links.
# These are simple redirect/contact links only (no OA/Messenger API).
# ---------------------------------------------------------------------------
# TODO(owner): real Shopee shop URL (banner shows "Nhà Len Nhỏ - Crochet").
NEXT_PUBLIC_SHOPEE_URL="https://shopee.vn/"
# TODO(owner): real Zalo contact number (https://zalo.me/<số-điện-thoại>)
NEXT_PUBLIC_ZALO_URL="https://zalo.me/0900000000"
# TODO(owner): real Facebook page/Messenger link.
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/<ten-fanpage>"

# ---------------------------------------------------------------------------
# API endpoints
# ---------------------------------------------------------------------------
# Public base URL of the Go API as reached by the browser. In production this
# is routed through Nginx Proxy Manager under the public domain.
NEXT_PUBLIC_API_URL="http://localhost:8080"
# Server-only base URL used by Next.js server components/SSR to reach the API
# over the private Docker network. NEVER exposed to browser code.
INTERNAL_API_URL="http://backend:8080"
# Exact browser origins allowed to call the API (comma-separated). No wildcard.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ---------------------------------------------------------------------------
# Backend HTTP server
# ---------------------------------------------------------------------------
APP_ENV="development"
LOG_LEVEL="info"                 # debug | info | warn | error
HTTP_ADDR="0.0.0.0"              # must be 0.0.0.0 inside containers
HTTP_PORT="8080"
HTTP_READ_TIMEOUT_SECONDS="15"
HTTP_WRITE_TIMEOUT_SECONDS="30"
HTTP_IDLE_TIMEOUT_SECONDS="60"
MAX_REQUEST_BODY_BYTES="1048576" # 1 MiB

# ---------------------------------------------------------------------------
# Database (PostgreSQL) — keep separate from source code
# ---------------------------------------------------------------------------
POSTGRES_USER="qg_app"
POSTGRES_PASSWORD="change-me-in-production"
POSTGRES_DB="qg_web"
# Connection string used by the backend. Host is the Docker service name.
DATABASE_URL="postgres://qg_app:change-me-in-production@database:5432/qg_web?sslmode=disable"

# ---------------------------------------------------------------------------
# Sessions / auth (server-only secrets)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48   (do NOT reuse the example value)
SESSION_SECRET="replace-with-a-long-random-secret"
SESSION_TTL_HOURS="24"
SESSION_COOKIE_NAME="qg_session"
SESSION_COOKIE_SECURE="false"    # set true in production (HTTPS via NPM)
# Set true ONLY for the cross-site free combo (ADR-0013: storefront on
# *.pages.dev / *.workers.dev, API on *.onrender.com). Requires
# SESSION_COOKIE_SECURE=true. Same-site VPS deployments must leave it false.
SESSION_COOKIE_SAMESITE_NONE="false"

# ---------------------------------------------------------------------------
# Public form abuse controls
# ---------------------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE="10"
RATE_LIMIT_PUBLIC_FORM_PER_MINUTE="5"
# Giới hạn toàn cục theo IP cho mọi endpoint công khai (duyệt sản phẩm, media…).
# Lớp bảo vệ trong cùng vẫn là các giới hạn chặt hơn ở trên.
RATE_LIMIT_GLOBAL_PER_MINUTE="300"
# Khóa tài khoản tạm thời khi một email bị thử sai mật khẩu quá nhiều lần
# (chống brute-force xoay IP). Chỉ đếm lần THẤT BẠI; đăng nhập thành công xóa bộ đếm.
RATE_LIMIT_ACCOUNT_FAILURES_PER_MINUTE="5"

# ---------------------------------------------------------------------------
# Order notification channel — BLOCKING OWNER DECISION (brief section 2.5)
# ---------------------------------------------------------------------------
# Allowed values: "none" | "email" | "telegram" | "zalo_bot"
# Until the owner confirms, leave "none" (the admin inbox still stores requests).
ORDER_NOTIFICATION_CHANNEL="none"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
ORDER_NOTIFICATION_EMAIL_TO=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---------------------------------------------------------------------------
# Uploads (admin product images) — stored IN THE DATABASE since ADR-0013
# (the free-PaaS target has no persistent disk). UPLOAD_DIR is gone.
# ---------------------------------------------------------------------------
UPLOAD_MAX_BYTES="5242880"       # 5 MiB per image
UPLOAD_MAX_DIMENSION="4000"

# ---------------------------------------------------------------------------
# Production networking ONLY (brief 4.4 / 7.2) — do NOT fill in yet.
# The owner provides the exact Docker network name used by Nginx Proxy Manager
# when production Compose is implemented. Never guess it.
# ---------------------------------------------------------------------------
NGINX_PROXY_NETWORK=""

# ---------------------------------------------------------------------------
# Initial admin account (used only by `go run ./cmd/migrate -seed`)
# ---------------------------------------------------------------------------
# Change the password before any real deployment. There is exactly one admin
# account for this first release (owner decision).
ADMIN_EMAIL="admin@nhallennho.local"
# BẮT BUỘC mạnh + duy nhất — repo là public nên mật khẩu mẫu/dễ đoán sẽ bị
# từ chối khi seed (auth.WeakAdminPassword), ví dụ các giá trị:
# change-this-admin-password / admin123 / 12345678...
ADMIN_PASSWORD="change-this-admin-password"

# ---------------------------------------------------------------------------
# Customer accounts
# ---------------------------------------------------------------------------
CUSTOMER_SESSION_COOKIE_NAME="qg_customer"
CUSTOMER_SESSION_TTL_HOURS="720"

# ---------------------------------------------------------------------------
# Bank-transfer payment (VietQR). TODO(owner): fill in the real account.
# Leave BANK_CODE/BANK_ACCOUNT_NUMBER empty to hide the QR and ask customers to
# contact the shop via Zalo instead.
# ---------------------------------------------------------------------------
BANK_CODE="BIDV"             # short bank code used by the QR service
BANK_ACCOUNT_NUMBER=""       # TODO(owner): real account number
BANK_ACCOUNT_NAME=""
BANK_NAME=""                 # display name, e.g. "Ngân hàng TMCP Đầu tư và Phát triển Việt Nam"
# Placeholders: {ACCOUNT_NUMBER} {BANK_NAME} (short code) {BANK_CODE} {BANK_FULL_NAME}
# {ACCOUNT_NAME} {AMOUNT} {DESCRIPTION}. SePay / VietQR template.
PAYMENT_QR_URL_TEMPLATE="https://vietqr.app/img?acc={ACCOUNT_NUMBER}&bank={BANK_NAME}&amount={AMOUNT}&des={DESCRIPTION}"

# ---------------------------------------------------------------------------
# Zalo Bot notifications (official Zalo Bot platform — free, NO Zalo OA needed)
# ---------------------------------------------------------------------------
# Setup (owner, ~2 minutes, from personal Zalo account):
#   1. Open Zalo app, search the OA "Zalo Bot Manager"
#   2. Tap "Tạo bot" in the chat menu → Zalo Bot Creator
#   3. Name the bot (must start with "Bot", e.g. "Bot NhaLenNho")
#   4. The Bot Token arrives via Zalo message (format: 12345689:abc-xyz)
#   5. Message your bot once from Zalo, then use Admin → Cài đặt →
#      "Lấy danh sách chat" to find your chatId, paste it below
# Docs: https://docs.zaloplatforms.com/docs/BOT
ZALO_BOT_TOKEN=""
ZALO_BOT_CHAT_ID=""
ZALO_BOT_API_BASE="https://bot-api.zaloplatforms.com"
